{
  "name": "hiraya-app-kit",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "workspaces": ["packages/*"],
  "scripts": {
    "build": "bun run clean && bun run build:packages",
    "build:packages": "bunx tsc -p packages/apps-contracts/tsconfig.build.json && bunx tsc -p packages/apps-sdk/tsconfig.build.json && bunx tsc -p packages/app-cli/tsconfig.build.json",
    "clean": "rm -rf packages/*/dist",
    "typecheck": "bunx tsc --noEmit",
    "test": "bun test packages",
    "lint": "bunx eslint .",
    "pack:check": "bun run build && bun scripts/pack-check.ts"
  },
  "devDependencies": {
    "@eslint/js": "9.30.1",
    "@types/bun": "1.2.18",
    "eslint": "9.30.1",
    "globals": "16.3.0",
    "typescript": "5.8.3",
    "typescript-eslint": "8.35.1"
  },
  "engines": {
    "bun": ">=1.2.0"
  },
  "packageManager": "bun@1.3.14",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hiraya-team/hiraya-app-kit.git"
  }
}

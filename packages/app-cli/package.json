{
  "name": "@hiraya-team/app-cli",
  "version": "1.0.0",
  "description": "CLI and secure archive inspection library for Hiraya apps and themes.",
  "type": "module",
  "bin": {
    "hiraya-app": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/archive.d.ts",
      "import": "./dist/archive.js"
    }
  },
  "types": "./dist/archive.d.ts",
  "files": [
    "dist",
    "templates",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hiraya-team/hiraya-app-kit.git",
    "directory": "packages/app-cli"
  },
  "license": "MIT",
  "dependencies": {
    "@hiraya-team/apps-contracts": "1.0.0",
    "acorn": "8.17.0",
    "fflate": "0.8.3",
    "parse5": "8.0.0"
  }
}

{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "preserve",
    "jsxImportSource": "@solidjs/web",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["bun"],
    "baseUrl": ".",
    "paths": {
      "@hiraya-team/apps-contracts": ["packages/apps-contracts/src/index.ts"],
      "@hiraya-team/apps-contracts/theme": ["packages/apps-contracts/src/theme.ts"],
      "@hiraya-team/apps-contracts/scene": ["packages/apps-contracts/src/scene.ts"],
      "@hiraya-team/apps-sdk": ["packages/apps-sdk/src/index.ts"],
      "@hiraya-team/app-cli": ["packages/app-cli/src/archive.ts"],
      "@hiraya-team/apps-ui": ["packages/apps-ui/src/index.ts"]
    }
  },
  "include": ["packages/**/*.ts", "packages/**/*.tsx", "scripts/**/*.ts"]
}
